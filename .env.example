# MedVerify NG environment. Copy to .env, then run `make run`.
# Never commit .env.
#
# Values here suit a process running on the host, talking to the compose
# services through published ports. docker-compose.yml overrides DATABASE_URL
# and STORAGE_ENDPOINT for containers, which use service names.

# --- Application -----------------------------------------------------------
# development | test | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP ------------------------------------------------------------------
# Address the API listens on.
HTTP_ADDR=:8080
# Host port published by docker compose for the api service.
HTTP_PORT=8080
# Time allowed to read the request head and body.
HTTP_READ_TIMEOUT=10s
# Time allowed to write a response.
HTTP_WRITE_TIMEOUT=20s
# How long an idle keep-alive connection is kept open.
HTTP_IDLE_TIMEOUT=60s
# Per-request deadline; handlers must honour the request context.
HTTP_REQUEST_TIMEOUT=15s
# In-flight requests get this long to finish after SIGTERM.
HTTP_SHUTDOWN_TIMEOUT=10s
# Global request body cap in bytes (1 MiB). Later phases tighten per route.
HTTP_MAX_BODY_BYTES=1048576

# --- Postgres --------------------------------------------------------------
# Required. postgres:// or postgresql:// URL. The pgvector image is mandatory
# because the vector extension is enabled by migration.
DATABASE_URL=postgres://medverify:medverify-local-password@localhost:5432/medverify?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_CONNECT_TIMEOUT=5s

# Compose-created database credentials. Must match DATABASE_URL when running
# on the host.
POSTGRES_USER=medverify
POSTGRES_PASSWORD=medverify-local-password
POSTGRES_DB=medverify
POSTGRES_PORT=5432

# --- Object storage (S3 compatible) ----------------------------------------
# Required. host:port with no scheme; STORAGE_USE_SSL selects http or https.
# The compose stack runs a SeaweedFS S3 gateway on published port 9000.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=medverify-dev
STORAGE_SECRET_KEY=medverify-dev-secret
STORAGE_BUCKET=medverify
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
# Host port published by docker compose for the storage service.
STORAGE_PORT=9000

# --- Background jobs -------------------------------------------------------
# Number of jobs the worker runs at once.
JOBS_CONCURRENCY=4
# Running jobs get this long to finish after SIGTERM.
JOBS_SHUTDOWN_TIMEOUT=15s
