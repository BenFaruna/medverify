# MedVerify NG environment. Copy to .env, then run `make run`.
# Never commit .env.
#
# Values here suit a process running on the host, talking to the compose
# services through published ports. docker-compose.yml overrides DATABASE_URL
# and STORAGE_ENDPOINT for containers, which use service names.

# --- Application -----------------------------------------------------------
# development | test | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP ------------------------------------------------------------------
# Address the API listens on.
HTTP_ADDR=:8080
# Host port published by docker compose for the api service.
HTTP_PORT=8080
# Time allowed to read the request head and body.
HTTP_READ_TIMEOUT=10s
# Time allowed to write a response.
HTTP_WRITE_TIMEOUT=20s
# How long an idle keep-alive connection is kept open.
HTTP_IDLE_TIMEOUT=60s
# Per-request deadline; handlers must honour the request context.
HTTP_REQUEST_TIMEOUT=15s
# In-flight requests get this long to finish after SIGTERM.
HTTP_SHUTDOWN_TIMEOUT=10s
# Global request body cap in bytes (1 MiB). Later phases tighten per route.
HTTP_MAX_BODY_BYTES=1048576

# --- Postgres --------------------------------------------------------------
# Required. postgres:// or postgresql:// URL. The pgvector image is mandatory
# because the vector extension is enabled by migration.
DATABASE_URL=postgres://medverify:medverify-local-password@localhost:5432/medverify?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_CONNECT_TIMEOUT=5s

# Compose-created database credentials. Must match DATABASE_URL when running
# on the host.
POSTGRES_USER=medverify
POSTGRES_PASSWORD=medverify-local-password
POSTGRES_DB=medverify
POSTGRES_PORT=5432

# --- Object storage (S3 compatible) ----------------------------------------
# Required. host:port with no scheme; STORAGE_USE_SSL selects http or https.
# The compose stack runs a SeaweedFS S3 gateway on published port 9000.
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=medverify-dev
STORAGE_SECRET_KEY=medverify-dev-secret
STORAGE_BUCKET=medverify
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
# Host port published by docker compose for the storage service.
STORAGE_PORT=9000

# --- Background jobs -------------------------------------------------------
# Number of jobs the worker runs at once.
JOBS_CONCURRENCY=4
# Running jobs get this long to finish after SIGTERM.
JOBS_SHUTDOWN_TIMEOUT=15s

# --- API authentication (phase 03 placeholder) -----------------------------
# Single shared key checked against the X-API-Key header. Phase 11 replaces it
# with per-client credentials. Change this outside local development.
API_KEY=dev-api-key

# --- Scan uploads (phase 03) ------------------------------------------------
# Images accepted per scan.
SCAN_MAX_IMAGES=4
# Per-image byte cap (10 MiB).
SCAN_MAX_IMAGE_BYTES=10485760
# Whole multipart body cap; must cover all images plus form overhead.
SCAN_MAX_REQUEST_BYTES=47185920
# Reject decompression bombs before decoding pixels.
SCAN_MAX_PIXELS=40000000
# How long POST /v1/scans waits before answering 202 and letting the client poll.
SCAN_SYNC_WAIT=5s
# How often the sync wait polls the scan row.
SCAN_POLL_INTERVAL=100ms
# Provider confidence below this becomes unreadable, never a guess.
SCAN_MIN_CONFIDENCE=0.5

# --- Label extraction (phase 04) -------------------------------------------
# fake | claude. fake is a deterministic local provider and is rejected in
# production. CI only ever uses fake and recorded contract fixtures.
VISION_PROVIDER=fake
# Pinned model id, never a floating alias. Required when VISION_PROVIDER=claude.
VISION_MODEL=claude-sonnet-4-5-20250929
# Optional second model used only when the primary provider is unavailable.
VISION_FALLBACK_MODEL=claude-haiku-4-5-20251001
# Provider secret. Required when VISION_PROVIDER=claude; never commit a real key.
VISION_API_KEY=
VISION_BASE_URL=https://api.anthropic.com
VISION_MAX_TOKENS=4096
# Per-attempt deadline and bounded retries for transient failures.
VISION_TIMEOUT=45s
VISION_RETRIES=2
VISION_RETRY_BACKOFF=500ms
# Circuit breaker: open after this many consecutive transient failures, then
# allow one trial after the cooldown.
VISION_CIRCUIT_FAILURE_THRESHOLD=5
VISION_CIRCUIT_COOLDOWN=30s
# Resize the longer image edge before sending it to the provider.
VISION_MAX_IMAGE_DIMENSION=1568
# USD per million tokens, used for the cost ledger. Update when prices change.
VISION_INPUT_PRICE_PER_MTOKEN=3
VISION_OUTPUT_PRICE_PER_MTOKEN=15

# --- Registry verification (phase 05) --------------------------------------
# Optional override for the versioned matching threshold file. Empty uses the
# embedded v1 file. Preview changes here; the file version is stored on results.
VERIFY_CONFIG_FILE=

# --- Ingredient safety checks (phase 06) -----------------------------------
# Optional override for the versioned safety threshold file. Empty uses the
# embedded v1 file. The version is logged by the worker at startup.
SAFETY_CONFIG_FILE=

# --- Greenbook ingestion (phase 02) ---------------------------------------
# Kill switch. false stops every outbound Greenbook request immediately.
GREENBOOK_ENABLED=true
# Public Greenbook base URL.
GREENBOOK_BASE_URL=https://greenbook.nafdac.gov.ng
# Honest client identity. Include a contact URL.
GREENBOOK_USER_AGENT=MedVerifyNG/0.1 (+https://github.com/benfaruna/medverify)
# Requests per second. Keep this low; the source is a public service.
GREENBOOK_RPS=1
# Leaflet downloads that may run at once.
GREENBOOK_MAX_CONCURRENCY=2
# Rows requested per list page.
GREENBOOK_PAGE_SIZE=100
# Per-request timeout.
GREENBOOK_REQUEST_TIMEOUT=30s
# Retries for network errors and 5xx. 4xx is never retried.
GREENBOOK_RETRIES=3
# On-disk response cache. Safe to delete; it is rebuilt.
GREENBOOK_CACHE_DIR=/tmp/medverify-greenbook-cache
# How long a cached list response is reused.
GREENBOOK_CACHE_TTL=1h
# Reject leaflets larger than 50 MiB.
GREENBOOK_MAX_PDF_BYTES=52428800
# Reject leaflets with more pages than this before extraction.
GREENBOOK_MAX_PDF_PAGES=100
# Comma-separated allowlist for leaflet downloads. Anything else is rejected.
GREENBOOK_ALLOWED_HOSTS=greenbook.nafdac.gov.ng,admin.greenbook.nafdac.gov.ng
# How often the worker runs the nightly sync.
GREENBOOK_SYNC_INTERVAL=24h
# Abort a sync if the row count drops by more than this percentage.
GREENBOOK_ANOMALY_MAX_DROP_PERCENT=30
# Abort a sync if more than this percentage of rows fail to parse.
GREENBOOK_ANOMALY_MAX_PARSE_FAILURE_PERCENT=10
